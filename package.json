{
  "name": "@mrnirmata/gauntlet",
  "version": "0.3.0",
  "description": "Adversarial checks for the code that turns model output into a tool call.",
  "keywords": [
    "tool-call",
    "llm",
    "agents",
    "security",
    "benchmark"
  ],
  "license": "MIT",
  "author": "MrNirmata",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gauntlet": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrNirmata/gauntlet.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc",
    "prepack": "node scripts/clean.mjs && tsc",
    "prepare": "node scripts/clean.mjs && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node scripts/clean.mjs && tsc && vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
